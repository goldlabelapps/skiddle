{
  "name": "@skiddle/cli",
  "version": "1.1.0",
  "description": "NX° Developer Experience CLI for Skiddle API",
  "type": "module",
  "bin": {
    "nx": "./bin/nx.js",
    "skiddle-nx": "./bin/nx.js"
  },
  "scripts": {
    "start": "node ./bin/nx.js",
    "cli": "node ./bin/nx.js",
    "doctor": "node ./bin/nx.js doctor",
    "test": "vitest run",
    "test:unit": "vitest run tests/cli.test.js",
    "test:e2e": "vitest run tests/e2e.test.js",
    "typecheck": "node ./scripts/lint.mjs",
    "lint": "node ./scripts/lint.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "@skiddle/sdk": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
