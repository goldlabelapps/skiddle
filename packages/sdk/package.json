{
  "name": "@skiddle/sdk",
  "version": "1.1.0",
  "description": "Modern TypeScript & JavaScript SDK for the Skiddle API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/sdk.test.ts",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "node ./scripts/lint.mjs"
  },
  "keywords": [
    "skiddle",
    "events",
    "ticketing",
    "api",
    "sdk",
    "typescript",
    "javascript"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}

