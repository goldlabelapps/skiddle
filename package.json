{
  "name": "skiddle",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "pnpm --filter skiddle-sdk build",
    "dev": "pnpm --filter skiddle-sdk dev",
    "test": "pnpm --filter skiddle-sdk test",
    "test:watch": "pnpm --filter skiddle-sdk test:watch",
    "test:coverage": "pnpm --filter skiddle-sdk test:coverage",
    "typecheck": "pnpm --filter skiddle-sdk typecheck",
    "cli": "node ./cli/bin/nx.js"
  }
}
